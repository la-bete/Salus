# Copy to server/.env and fill in. Placeholder values only.

PORT=3000
MONGODB_URI=mongodb://localhost:27017/salus
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_NAME=salus.sid
SITE_URL=http://localhost:3000
APP_NAME=Salus
# Number of reverse-proxy hops to trust (0 when running directly)
TRUST_PROXY_SETTING=0

# Remember-me cookie
REMEMBER_ME_COOKIE_NAME=salus.remember
REMEMBER_ME_COOKIE_LENGTH=20
# Days
REMEMBER_ME_COOKIE_EXPIRY=7

# Password reset token
RESET_TOKEN_LENGTH=40
# Hours
RESET_TOKEN_EXPIRY=6

# SMTP (connection uses port 465)
MAILER_HOST=smtp.example.com
MAILER_USERNAME=your-smtp-username
MAILER_PASSWORD=your-smtp-password
MAILER_ADDRESS=no-reply@example.com
PASSWORD_RESET_MAIL_THEME=cerberus

# OAuth providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret
TWITTER_KEY=your-twitter-consumer-key
TWITTER_SECRET=your-twitter-consumer-secret

# Set to any value to also log expected (KnownError) errors
# LOG_KNOWN_ERRORS=1
